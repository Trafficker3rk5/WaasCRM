# ====================================
# CONFIGURACIÓN DE PRODUCCIÓN - WaasCRM
# ====================================
#
# IMPORTANTE: Este archivo es una plantilla para producción.
# Copia este archivo a .env.production y completa con valores reales.
# NUNCA commitees este archivo con valores reales al repositorio.
#
# ====================================

# ====================================
# APLICACIÓN
# ====================================
APP_NAME=WaasCRM
APP_ENV=production
APP_KEY=base64:GENERA_ESTO_CON_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://tudominio.com

# ====================================
# LOGGING Y DEBUGGING
# ====================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_SLACK_WEBHOOK_URL=

# ====================================
# BASE DE DATOS PRINCIPAL (PostgreSQL)
# ====================================
# IMPORTANTE: Usa PostgreSQL en producción
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=waascrm_production
DB_USERNAME=waascrm_user
DB_PASSWORD=CAMBIA_ESTO_POR_PASSWORD_SEGURO

# ====================================
# CACHE Y SESIONES
# ====================================
# Recomendado: Redis para producción
BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ====================================
# REDIS
# ====================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# ====================================
# MEMCACHED (Alternativa a Redis)
# ====================================
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# ====================================
# EMAIL (SMTP)
# ====================================
# Configura tu servicio de email (SendGrid, Mailgun, SES, etc.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.tuservidor.com
MAIL_PORT=587
MAIL_USERNAME=tuusuario@tudominio.com
MAIL_PASSWORD=CAMBIA_ESTO_POR_TU_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

# ====================================
# ALMACENAMIENTO EN LA NUBE (AWS S3)
# ====================================
# Recomendado para archivos en producción
AWS_ACCESS_KEY_ID=TU_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TU_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=waascrm-production-files
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=

# Alternativa: DigitalOcean Spaces
# AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_URL=https://tu-bucket.nyc3.digitaloceanspaces.com

# ====================================
# PUSHER (Real-time broadcasting)
# ====================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ====================================
# VITE (Frontend assets)
# ====================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ====================================
# RECAPTCHA (Seguridad)
# ====================================
RECAPTCHA_SITE_KEY=TU_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=TU_RECAPTCHA_SECRET_KEY

# ====================================
# SERVICIOS DE TERCEROS
# ====================================

# Mailgun (opcional)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Postmark (opcional)
POSTMARK_TOKEN=

# ====================================
# SEGURIDAD
# ====================================
# Fuerza HTTPS en producción
FORCE_HTTPS=true

# Configuración de CORS
# Lista de dominios permitidos separados por coma
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ====================================
# MULTI-TENANCY
# ====================================
# Configuración específica para tenancy
CENTRAL_DOMAIN=admin.tudominio.com
TENANT_SUBDOMAIN=*.tudominio.com

# Límites de tenants
MAX_TENANTS=1000
TENANT_DATABASE_PREFIX=tenant_

# ====================================
# RENDIMIENTO
# ====================================
# Optimización de queries
DB_SLOW_QUERY_LOG=true
DB_SLOW_QUERY_TIME=2000

# Compresión de respuestas
RESPONSE_COMPRESSION=true

# ====================================
# MONITOREO Y ALERTAS
# ====================================
# Sentry para tracking de errores
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=WaasCRM

# ====================================
# BACKUP
# ====================================
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=admin@tudominio.com
BACKUP_SCHEDULE=daily

# ====================================
# LÍMITES Y THROTTLING
# ====================================
API_RATE_LIMIT=60
API_RATE_LIMIT_WINDOW=1

# ====================================
# FEATURES FLAGS
# ====================================
FEATURE_PDF_GENERATION=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SMS_NOTIFICATIONS=false

# ====================================
# NOTAS IMPORTANTES PARA PRODUCCIÓN
# ====================================
#
# 1. SEGURIDAD:
#    - APP_DEBUG debe ser false
#    - Genera APP_KEY nuevo: php artisan key:generate
#    - Usa passwords seguros para DB y servicios
#    - Activa SESSION_SECURE_COOKIE=true
#    - Configura CORS correctamente
#
# 2. RENDIMIENTO:
#    - Usa Redis para cache, sessions y queues
#    - Configura opcache en PHP
#    - Usa CDN para assets estáticos
#    - Activa compresión gzip en servidor web
#
# 3. BASE DE DATOS:
#    - Usa PostgreSQL (más robusto que MySQL)
#    - Configura backups automáticos
#    - Usa conexiones persistentes
#    - Monitorea queries lentas
#
# 4. ARCHIVOS:
#    - Usa S3 o similar para almacenamiento
#    - No guardes archivos en servidor local
#    - Configura lifecycle policies para archivos antiguos
#
# 5. EMAIL:
#    - Usa servicio dedicado (SendGrid, Mailgun, SES)
#    - Configura SPF, DKIM, DMARC
#    - Monitorea bounces y complaints
#
# 6. MONITOREO:
#    - Instala Sentry para tracking de errores
#    - Configura alertas de rendimiento
#    - Monitorea uso de recursos
#
# 7. BACKUPS:
#    - Backups automáticos diarios
#    - Guarda backups en ubicación separada
#    - Prueba restauración periódicamente
#
# 8. SSL/TLS:
#    - Usa certificado SSL válido
#    - Fuerza HTTPS en toda la aplicación
#    - Configura HSTS headers
#
# 9. OPTIMIZACIÓN LARAVEL:
#    - php artisan config:cache
#    - php artisan route:cache
#    - php artisan view:cache
#    - php artisan optimize
#
# 10. MULTI-TENANCY:
#     - Verifica aislamiento de datos entre tenants
#     - Configura límites por tenant
#     - Monitorea uso por tenant
#
# ====================================
